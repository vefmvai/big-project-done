#!/usr/bin/env bash
# Точка входа валидатора BPD.
#
# Сам валидатор лежит в scripts/ — рядом с правилами, которые он проверяет.
# Обёртка нужна ровно за одним: чтобы «нечем проверить» не выглядело как
# «всё чисто». Без неё отсутствие python3 давало бы «exec: python3: not found»
# и код 127 — постороннюю беду, по которой не догадаешься, что проверка
# не выполнялась вовсе.
#
# Коды возврата совпадают с валидатором: 0 чисто, 1 проблемы, 2 не состоялось.

set -euo pipefail

# Путь к себе разбираем средствами самого bash, без dirname и прочих внешних
# команд: при урезанном PATH они не находятся, и обёртка падала бы с кодом 127 —
# ровно той посторонней бедой, от которой она и должна защищать. Поймано
# тестом «нет python3», который запускает её с пустым PATH.
папка_файла() {
  case "$1" in
    */*) printf '%s\n' "${1%/*}" ;;
    *)   printf '%s\n' "." ;;
  esac
}

SRC="${BASH_SOURCE[0]}"
# Разворачиваем цепочку симлинков: скрипт могут слинковать в чужой bin/.
# readlink — внешняя команда, поэтому только если она вообще доступна.
if command -v readlink >/dev/null 2>&1; then
  while [ -L "$SRC" ]; do
    TGT="$(readlink "$SRC")"
    case "$TGT" in
      /*) SRC="$TGT" ;;
      *)  SRC="$(cd "$(папка_файла "$SRC")" && pwd)/$TGT" ;;
    esac
  done
fi
DIR="$(cd "$(папка_файла "$SRC")/.." && pwd)"

if ! command -v python3 >/dev/null 2>&1; then
  echo "ОШИБКА: не найден python3 — прогон невозможен." >&2
  echo "    Им запускается валидатор BPD и хуки автопроверки." >&2
  echo "    Проверить: python3 --version" >&2
  echo "    Поставить: https://www.python.org/downloads/" >&2
  echo "    Это НЕ «в проекте всё чисто»: проверка не выполнялась." >&2
  exit 2
fi

exec python3 "$DIR/scripts/validate.py" "$@"
